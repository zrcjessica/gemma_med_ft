# ---------------------------------------------------------------------------
# barney.env — per-user config for the lab's self-hosted Kimi endpoint
# ("Barney"). The judge sbatch scripts source this automatically. Set
# JUDGE_API_KEY to your NetID below, then run as usual:
#
#     # edit JUDGE_API_KEY -> your NetID
#     sbatch --export=ALL,TAG=... scripts/judge_traj.sbatch
#
# Everything here is optional — delete this file and the scripts behave exactly
# as before (untracked, port 8000, CONC=16).
# ---------------------------------------------------------------------------

# Route requests through the GATEWAY (port 8001), which logs per-user usage.
# The raw serve (8000) also works but is untracked. Leave this at 8001.
KIMI_PORT=8001

# Your identity on the endpoint = your NYU NetID (Kerberos ID). Sent as the API
# token and logged as the user for every request (honor system). CHANGE THIS to
# your NetID, or your usage shows up as "CHANGEME".
JUDGE_API_KEY=CHANGEME

# Max concurrent requests your job sends (passed to judge.py --concurrency).
# Keep  CONC x avg_prompt_tokens  well under the shared KV budget (~850k tokens,
# half reserved). For ~2-3k-token judge calls, 20 is safe and fair.
CONC=20

# Optional: pin the endpoint instead of auto-discovering the head node. Normally
# leave UNSET — scripts/kimi_url.sh finds the live server (its node moves when
# the serve job restarts). If you set it, include the :8001 gateway port.
# JUDGE_BASE_URL=http://sp-0005:8001/v1
