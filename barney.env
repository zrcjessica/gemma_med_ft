# ---------------------------------------------------------------------------
# barney.env — config for the lab's self-hosted Kimi endpoint ("Barney"). The
# judge sbatch scripts source this automatically, and nothing here needs
# editing — the defaults are correct for every user:
#
#     sbatch --export=ALL,TAG=... scripts/judge_traj.sbatch
#
# Every value is a `:-` default, so an explicit env var wins over this file:
#
#     sbatch --export=ALL,TAG=...,CONC=8 scripts/judge_traj.sbatch
#
# For a personal override that is never committed, put it in barney.local.env
# (gitignored) — it is sourced first, and these defaults only fill the gaps.
#
# Everything here is optional — delete this file and the scripts behave exactly
# as before (port 8000, CONC=16).
# ---------------------------------------------------------------------------

# Route requests through the GATEWAY (port 8001), which logs per-user usage.
# The raw serve (8000) also works but is untracked. Leave this at 8001.
KIMI_PORT=${KIMI_PORT:-8001}

# Your identity on the endpoint = your NYU NetID (Kerberos ID). Sent as the API
# token and logged as the user for every request (honor system). On BigPurple —
# the only place PROVIDER=local can reach the server at all — the NetID *is*
# your login name, so detect it rather than making each user edit this file.
# Override in barney.local.env if yours somehow differs.
JUDGE_API_KEY=${JUDGE_API_KEY:-$(id -un)}

# Max concurrent requests your job sends (passed to judge.py --concurrency).
# Keep  CONC x avg_prompt_tokens  well under the shared KV budget (~850k tokens,
# half reserved). For ~2-3k-token judge calls, 20 is safe and fair.
CONC=${CONC:-20}

# Optional: pin the endpoint instead of auto-discovering the head node. Normally
# leave UNSET — scripts/kimi_url.sh finds the live server (its node moves when
# the serve job restarts). If you set it, include the :8001 gateway port.
# JUDGE_BASE_URL=http://sp-0005:8001/v1
