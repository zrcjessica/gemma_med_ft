# ---------------------------------------------------------------------------
# barney.env.example — per-user config for the lab's self-hosted Kimi endpoint
# ("Barney"). Copy this to barney.env and fill in YOUR values. barney.env is
# gitignored, so your key never lands on GitHub. The judge sbatch scripts source
# it automatically:
#
#     cp barney.env.example barney.env
#     # edit barney.env: set JUDGE_API_KEY to your NetID
#     sbatch --export=ALL,TAG=... scripts/judge_traj.sbatch
#
# Everything here is optional — with no barney.env the scripts behave exactly as
# before (untracked, port 8000, CONC=16).
# ---------------------------------------------------------------------------

# Route requests through the GATEWAY (port 8001), which logs per-user usage.
# The raw serve (8000) also works but is untracked and unauthenticated.
# Leave this at 8001.
KIMI_PORT=8001

# Your identity on the endpoint = your NYU NetID (Kerberos ID). It's sent as the
# API token and logged as the user for every request (honor system). CHANGE THIS
# to your NetID, or your usage shows up as "CHANGEME".
JUDGE_API_KEY=CHANGEME

# Max concurrent requests your job sends (passed to judge.py --concurrency).
# Rule of thumb: keep  CONC x avg_prompt_tokens  well under the shared KV budget
# (~850k tokens, half reserved). For ~2-3k-token judge calls, 20 is safe and
# fair; raise only when the box is quiet.
CONC=20

# Optional: pin the endpoint instead of auto-discovering the head node. Normally
# leave this UNSET — scripts/kimi_url.sh finds the live server for you (its node
# moves whenever the serve job restarts). If you do set it, include :8001.
# JUDGE_BASE_URL=http://sp-0005:8001/v1
